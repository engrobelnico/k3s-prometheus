  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Overall GitHub status derived from https://www.githubstatus.com/api/v2/status.json. RED when GitHub reports a minor, major, critical or maintenance indicator.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "index": 1,
                  "text": "DEGRADED / OUTAGE"
                },
                "1": {
                  "index": 0,
                  "text": "OPERATIONAL"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "match": "null+nan",
                "result": {
                  "color": "gray",
                  "text": "NO DATA"
                }
              },
              "type": "special"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "min(probe_success{target=\"github-status-overall\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GitHub Overall Status",
      "type": "stat"
    },
